<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 地圖輔助：GPS ＋ OpenStreetMap（Overpass）下載道路資料 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 車機訊號探測：要看得到廠商系統 App 才能找方向燈/CAN 廣播 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- USB 探測（UVC 採集盒偵測） -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".AvmApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AvmProbe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 宣告成地圖/導航類：車機 ROM 多半用這個把導航 App 排除在「行駛中禁止觀看」之外。
                     能不能生效要看 ROM 怎麼判斷（有些是寫死套件名白名單），待實車確認。 -->
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UvcActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".CameraTestActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SignalProbeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".QuadActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="landscape" />

        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
